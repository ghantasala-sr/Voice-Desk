# Copy to .env and fill in the keys. `.env` is gitignored.
#
#   cp .env.example .env
#
# Every non-secret setting has a working default in core/settings.py, so a
# minimal .env only needs ANTHROPIC_API_KEY to run `make chat`.

# ---------------------------------------------------------------------------
# Provider keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                 # optional — only for VD_LLM_PROVIDER=openai
DEEPGRAM_API_KEY=               # week 1: needed for `make dev`, not for `make chat`
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# ---------------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------------
VD_LLM_PROVIDER=anthropic       # anthropic | openai | replay
VD_LLM_MODEL=claude-sonnet-5
VD_LLM_TEMPERATURE=0.2
VD_LLM_MAX_TOKENS=512

VD_STT_PROVIDER=deepgram        # deepgram | faster_whisper | null
VD_TTS_PROVIDER=cartesia        # cartesia | null

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Host ports. 5432 is very often already taken by a native Postgres install,
# and 4317 by another OTLP collector, so the defaults step around both.
VD_PG_PORT=5434
VD_JAEGER_UI_PORT=16687
VD_OTLP_PORT=4319
VD_APP_PORT=8088

VD_DATABASE_URL=postgresql://voicedesk:voicedesk@localhost:5434/voicedesk

# ---------------------------------------------------------------------------
# Domain
# ---------------------------------------------------------------------------
VD_DOMAIN=ticketing

# ---------------------------------------------------------------------------
# Turn-taking.
#
# VD_VAD_STOP_SECS is the single largest term in voice-to-voice latency and
# the main driver of whether the agent feels natural or rude. Do not lower it
# to improve a latency number — that buys the number instead of earning it.
#
# The value below is a starting point. W1-9 replaces it with a tuned value and
# names the run directory that produced it. See docs/10-audio-pipeline.md §2.
# ---------------------------------------------------------------------------
VD_VAD_STOP_SECS=0.4
VD_VAD_START_SECS=0.2
VD_VAD_CONFIDENCE=0.7
VD_SILENCE_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Budgets — docs/01-architecture.md §5
# ---------------------------------------------------------------------------
VD_TURN_BUDGET_MS=2500          # to first audio; exceeded -> fallback line
VD_TOOL_FILLER_MS=700           # tool slower than this -> speak filler (week 2)
VD_TOOL_TIMEOUT_MS=4000
VD_MAX_TOOL_ITERATIONS=3
VD_READBACK_TIMEOUT_MS=6000
VD_ACK_AFTER_MS=350             # TTFT past this -> acknowledgment line (week 2)

# How much of the audio handed to the transport we assume the caller did NOT
# hear when they interrupted. Errs toward assuming they heard less, which is
# the safe direction. See docs/04-providers.md §3.
VD_PLAYOUT_TRIM_MS=120

# ---------------------------------------------------------------------------
# Retrieval — week 2
# ---------------------------------------------------------------------------
VD_EMBED_MODEL=BAAI/bge-small-en-v1.5
VD_RETRIEVAL_TOP_K=4
VD_RRF_K=60

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4319
OTEL_SERVICE_NAME=voicedesk
VD_TRACING_ENABLED=true
VD_LOG_LEVEL=INFO
VD_LOG_JSON=false               # true in containers, false for a readable terminal
